# ====================================================================
# ConvoLab Environment Configuration
# Copy this file to .env.local for local testing, or add to your Vercel
# Project Settings > Environment Variables for production deployment.
# ====================================================================

# Google Gemini API Key for real-time communication analysis.
# Get a free API key at: https://aistudio.google.com/app/apikey
# If left blank, ConvoLab operates in clearly-labeled DEMO MODE with rule-based evaluation.
GEMINI_API_KEY=

# Model name to use (default: gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Passcode for accessing the Researcher/Admin Analytics Dashboard at /admin
# Default is 'convolab2025' if unset. Change this before sharing publicly!
RESEARCH_PASSCODE=convolab2025
